# Choose: fallback, openai, anthropic, gemini, mistral, openrouter, groq, ollama, custom
AI_PROVIDER=fallback
AI_MODEL=local-fallback
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1400

# OpenAI-compatible / official providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.5

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama, e.g. llama3.1, mistral, qwen2.5, gemma3
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Any OpenAI-compatible endpoint
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=


# --- Communication and calendar integrations ---
# Google OAuth (Gmail + Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.events

# Microsoft Graph OAuth (Outlook Mail + Calendar)
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback
MS_SCOPES=offline_access Mail.Send Mail.Read Calendars.ReadWrite

# Twilio SMS / Voice / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_FROM_NUMBER=

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Safety switch: keep live sending disabled until you confirm connectors.
ENABLE_LIVE_SEND=false
